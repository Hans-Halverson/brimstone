[CompiledRegExp: /[a-z]/] {
  Flags: "i"
  Match Start: Code Points("A"-"Z", "a"-"z")
     0: MarkCapturePoint(0)
     2: CodePointSet("A"-"Z", "a"-"z")
     4: MarkCapturePoint(1)
     6: Accept
}

[CompiledRegExp: /\w/] {
