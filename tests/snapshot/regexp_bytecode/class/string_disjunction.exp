[CompiledRegExp: /[\q{ab}c]/] {
  Flags: "v"
  Match Start: Code Points("a", "c")
     0: MarkCapturePoint(0)
     2: Branch(8, 12)
     5: MarkCapturePoint(1)
     7: Accept
     8: Literal(a)
     9: Literal(b)
    10: Jump(5)
    12: Literal(c)
    13: Jump(5)
}

