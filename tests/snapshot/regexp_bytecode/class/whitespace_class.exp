[CompiledRegExp: /[\sa-z][\S\x0A-\x0C]/] {
  Flags: ""
  Match Start: Code Points("\t"-"\r", "\u{20}", "a"-"z", "\u{A0}", "\u{1680}", "\u{2000}"-"\u{200A}", "\u{2028}"-"\u{2029}", "\u{202F}", "\u{205F}", "\u{3000}", "﻿")
     0: MarkCapturePoint(0)
