     0: Mov r0, a0
     3: LoadImmediate a0, 2
     6: Mov r1, a0
     9: Add r0, r0, r1
    13: JumpToBooleanFalse r0, 3 (.L0)
  .L0:
    16: LoadUndefined r0
    18: Ret r0
}

[BytecodeFunction: inRegularParam] {
