[BytecodeFunction: inCatchParam] {
  Parameters: 1, Registers: 5
     0: Mov r1, <scope>
     3: LoadImmediate r2, 1
     6: Jump 25 (.L0)
     8: Mov <scope>, r1
    11: Mov r3, a0
    14: LoadImmediate a0, 2
    17: Mov r4, a0
    20: Add r3, r3, r4
    24: GetProperty r0, r2, r3
    28: LoadImmediate r2, 3
  .L0:
    31: LoadUndefined r1
    33: Ret r1
  Exception Handlers:
    3-6 -> 8 (r2)
}

