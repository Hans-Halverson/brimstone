[CompiledRegExp: /[a-z]/] {
  Flags: "i"
  Match Start: Code Points("A"-"Z", "a"-"z")
     0: MarkCapturePoint(0)
     2: CompareBetween(A, Z)
     4: CompareBetween(a, z)
     6: ConsumeIfTrue
     7: MarkCapturePoint(1)
     9: Accept
}

[CompiledRegExp: /\w/] {
  Flags: "i"
  Match Start: Code Points("0"-"9", "A"-"Z", "_", "a"-"z")
     0: MarkCapturePoint(0)
     2: CompareBetween(0, 9)
     4: CompareBetween(A, Z)
     6: CompareEquals(_)
     7: CompareBetween(a, z)
     9: ConsumeIfTrue
    10: MarkCapturePoint(1)
    12: Accept
}

[CompiledRegExp: /[a-z]/] {
  Flags: "iu"
  Match Start: Code Points("A"-"Z", "a"-"z", "ſ", "K")
     0: MarkCapturePoint(0)
     2: CompareBetween(A, Z)
     4: CompareBetween(a, z)
     6: CompareEquals(ſ)
     7: CompareEquals(K)
     8: ConsumeIfTrue
     9: MarkCapturePoint(1)
    11: Accept
}

[CompiledRegExp: /\w/] {
  Flags: "iu"
  Match Start: Code Points("0"-"9", "A"-"Z", "_", "a"-"z", "ſ", "K")
     0: MarkCapturePoint(0)
     2: CompareBetween(0, 9)
     4: CompareBetween(A, Z)
     6: CompareEquals(_)
     7: CompareBetween(a, z)
     9: CompareEquals(ſ)
    10: CompareEquals(K)
    11: ConsumeIfTrue
    12: MarkCapturePoint(1)
    14: Accept
}

[CompiledRegExp: /[^a-z]/] {
  Flags: "i"
  Match Start: Code Points("\x00"-"@", "["-"`", "{"-"\u{10FFFF}")
     0: MarkCapturePoint(0)
     2: CompareBetween(A, Z)
     4: CompareBetween(a, z)
     6: ConsumeIfFalse
     7: MarkCapturePoint(1)
     9: Accept
}

[CompiledRegExp: /\W/] {
  Flags: "i"
  Match Start: Code Points("\x00"-"/", ":"-"@", "["-"^", "`", "{"-"\u{10FFFF}")
     0: MarkCapturePoint(0)
     2: CompareBetween(\x00, /)
     4: CompareBetween(:, @)
     6: CompareBetween([, ^)
     8: CompareEquals(`)
     9: CompareBetween({, \u{10FFFF})
    11: ConsumeIfTrue
    12: MarkCapturePoint(1)
    14: Accept
}

[CompiledRegExp: /\W/] {
  Flags: "iu"
  Match Start: Code Points("\x00"-"/", ":"-"@", "["-"^", "`", "{"-"ž", "ƀ"-"℩", "Å"-"\u{10FFFF}")
     0: MarkCapturePoint(0)
     2: CompareBetween(\x00, /)
     4: CompareBetween(:, @)
     6: CompareBetween([, ^)
     8: CompareEquals(`)
     9: CompareBetween({, ž)
    11: CompareBetween(ƀ, ℩)
    13: CompareBetween(Å, \u{10FFFF})
    15: ConsumeIfTrue
    16: MarkCapturePoint(1)
    18: Accept
}

