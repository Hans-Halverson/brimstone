[CompiledRegExp: /\s\S/] {
  Flags: ""
  Match Start: Code Points("\t"-"\r", "\u{20}", "\u{A0}", "\u{1680}", "\u{2000}"-"\u{200A}", "\u{2028}"-"\u{2029}", "\u{202F}", "\u{205F}", "\u{3000}", "﻿")
     0: MarkCapturePoint(0)
     2: CompareBetween(\t, \r)
     4: CompareEquals(\u{20})
     5: CompareEquals(\u{A0})
     6: CompareEquals(\u{1680})
     7: CompareBetween(\u{2000}, \u{200A})
     9: CompareBetween(\u{2028}, \u{2029})
    11: CompareEquals(\u{202F})
    12: CompareEquals(\u{205F})
    13: CompareEquals(\u{3000})
    14: CompareEquals(﻿)
    15: ConsumeIfTrue
    16: CompareBetween(\x00, \x08)
    18: CompareBetween(\x0E, \x1F)
    20: CompareBetween(!, \x9F)
    22: CompareBetween(¡, ᙿ)
    24: CompareBetween(ᚁ, ῿)
    26: CompareBetween(​, ‧)
    28: CompareBetween(‪, ‮)
    30: CompareBetween(‰, ⁞)
    32: CompareBetween(⁠, ⿿)
    34: CompareBetween(、, ﻾)
    36: CompareBetween(＀, \u{10FFFF})
    38: ConsumeIfTrue
    39: MarkCapturePoint(1)
    41: Accept
}

